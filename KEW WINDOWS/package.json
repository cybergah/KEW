{
  "name": "kew-windows",
  "private": true,
  "version": "2.0.0",
  "description": "Kew — anonymous, free video downloader for Windows and macOS. Cybergah Group (cybergah.com)",
  "author": "Cybergah Group <info@cybergah.com>",
  "license": "GPL-3.0-or-later",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "electron": "electron .",
    "dist": "vite build && electron-builder --win",
    "test": "node --test test/security.test.cjs",
    "typecheck": "tsc --noEmit -p .",
    "dist:mac": "vite build && electron-builder --mac"
  },
  "dependencies": {
    "lucide-react": "1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-icons": "16.33.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.cybergah.kew",
    "productName": "Kew",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "resources/icon.ico",
      "extraResources": [
        {
          "from": "resources",
          "to": "resources"
        },
        {
          "from": "browser-extension",
          "to": "browser-extension"
        }
      ]
    },
    "portable": {
      "artifactName": "Kew-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Kew-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "minimumSystemVersion": "10.15",
      "x64ArchFiles": "Contents/Resources/resources/{yt-dlp,ffmpeg}",
      "icon": "resources-mac/icon.icns",
      "category": "public.app-category.video",
      "extraResources": [
        {
          "from": "resources-mac",
          "to": "resources",
          "filter": [
            "yt-dlp",
            "ffmpeg",
            "ffmpeg.LICENSE",
            "ffmpeg.README",
            "tray.png",
            "tray@2x.png",
            "icon.icns"
          ]
        },
        {
          "from": "browser-extension",
          "to": "browser-extension"
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Kew-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Kew ${version}"
    },
    "afterPack": "tools/after-pack-mac.cjs"
  }
}
